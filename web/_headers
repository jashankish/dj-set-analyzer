# Cache rules for static hosts that read a _headers file (Netlify, Cloudflare Pages).
# Code and pages revalidate on every load, so a deploy is picked up at once and
# browsers never mix old and new modules. The large, versioned assets cache hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

/models/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  Cache-Control: public, max-age=3600
